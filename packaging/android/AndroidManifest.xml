<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.horizonlab.horizon"
    android:versionCode="55"
    android:versionName="0.3.9">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- The launcher installs Horizon VR's updates (Updater.java). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- VR (Quest): the Khronos OpenXR loader finds the headset's runtime through its broker. -->
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR" />
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR_SYSTEM" />
    <queries>
        <provider android:authorities="org.khronos.openxr.runtime_broker;org.khronos.openxr.system_runtime_broker" />
        <intent>
            <action android:name="org.khronos.openxr.OpenXRRuntimeService" />
        </intent>
        <intent>
            <action android:name="org.khronos.openxr.OpenXRApiLayerService" />
        </intent>
    </queries>
    <uses-feature android:name="android.hardware.vr.headtracking" android:version="1" android:required="false" />
    <!-- Meta Quest: the headset's own keyboard shows over the game when a text field asks for it. -->
    <uses-feature android:name="oculus.software.overlay_keyboard" android:required="false" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x400003" android:required="false" />
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:debuggable="false"
        android:allowBackup="false"
        android:hasCode="true"
        android:extractNativeLibs="true"
        android:largeHeap="true"
        android:theme="@style/HorizonGame">
        <!-- Quest 1 build: its VR runtime aborts at xrCreateInstance on a name it doesn't
             know ("Unknown device to support: quest3"), so only the names it knows. -->
        <meta-data android:name="com.oculus.supportedDevices" android:value="quest|quest2" />
        <profileable android:shell="true" />
        <activity
            android:name=".SetupActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".HorizonActivity"
            android:exported="false"
            android:taskAffinity="dev.horizonlab.horizon.vr"
            android:screenOrientation="sensorLandscape"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustNothing|stateHidden"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density|smallestScreenSize|fontScale|locale|layoutDirection|touchscreen|mcc|mnc|colorMode|fontWeightAdjustment|grammaticalGender">
            <meta-data android:name="android.app.lib_name" android:value="horizon" />
            <!-- Quest: the game is an immersive (VR) activity, opened from the 2D setup panel. It
                 runs in a task of its own (taskAffinity, started with FLAG_ACTIVITY_NEW_TASK):
                 in the panel's task its window opened on the panel's display and the VR session
                 never got focus (Quest 1: flat, no controllers). -->
            <meta-data android:name="com.oculus.vr.focusaware" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.oculus.intent.category.VR" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ProfileActivity"
            android:exported="false"
            android:theme="@style/HorizonProfile"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|smallestScreenSize"
            android:windowSoftInputMode="adjustPan|stateHidden" />
        <activity
            android:name=".MsaLoginActivity"
            android:exported="false"
            android:theme="@style/HorizonProfile"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|smallestScreenSize"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ModImportActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter android:label="Install mod">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
            </intent-filter>
            <intent-filter android:label="Install mod">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
            </intent-filter>
            <!-- File managers that send any type: matched by the .hnmod / .hmod name. -->
            <intent-filter android:label="Install mod">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.hnmod" />
                <data android:pathPattern=".*\\..*\\.hnmod" />
                <data android:pathPattern=".*\\.hmod" />
                <data android:pathPattern=".*\\..*\\.hmod" />
            </intent-filter>
        </activity>
        <service
            android:name=".SetupService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <provider
            android:name=".HorizonDocumentsProvider"
            android:authorities="dev.horizonlab.horizon.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>
